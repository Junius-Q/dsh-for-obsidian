    "obsidian",
    "plugin",
    "deepseek",
    "dsh",
    "agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.4.11",
    "tslib": "^2.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {}
}
