{
  "name": "obsidian-dsh",
  "version": "0.1.0",
  "description": "dsh for Obsidian — a Claudian-style local AI agent running DeepSeek Harness inside your vault.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
